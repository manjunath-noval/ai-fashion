
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Secure wardrobe collection
    match /wardrobe/{wardrobeId} {

      // Only the owner can read their wardrobe
      allow read: if request.auth != null
                  && resource.data.userId == request.auth.uid;

      // Only authenticated users can create their own items
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;

      // Only the owner can update their items
      allow update: if request.auth != null
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == request.auth.uid;

      // Only the owner can delete their items
      allow delete: if request.auth != null
                    && resource.data.userId == request.auth.uid;
    }

    // Deny access to all other collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
